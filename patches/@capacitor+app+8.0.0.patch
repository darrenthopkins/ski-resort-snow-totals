+import Foundation
+import Capacitor
+import ObjectiveC.runtime
+
+extension CAPPluginCall {
+    func rejectShim(
+        _ message: String,
+        _ code: String? = nil,
+        _ error: Error? = nil,
+        _ data: [String: Any]? = nil
+    ) {
+        let sel = NSSelectorFromString("reject::::")
+
+        guard responds(to: sel) else {
+            unavailable(message)
+            return
+        }
+
+        typealias MsgSendFn = @convention(c) (
+            AnyObject,
+            Selector,
+            NSString,
+            NSString?,
+            NSError?,
+            NSDictionary?
+        ) -> Void
+
+        let fn = unsafeBitCast(objc_msgSend, to: MsgSendFn.self)
+        fn(self, sel,
+           message as NSString,
+           code as NSString?,
+           error as NSError?,
+           data as NSDictionary?)
+    }
+}
+
